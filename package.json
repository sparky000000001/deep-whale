{
  "name": "dsh-deep-line-theme",
  "version": "1.0.0",
  "description": "Deep Line theme for DeepSeek Harness: line-art backdrop, accent / border / fill colors and text effects, all adjustable in Settings.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-layout"]
    }
  },
  "keywords": ["dsh", "deepseek-harness", "theme", "plugin", "line-art"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_NAME/dsh-deep-line-theme.git"
  },
  "bugs": {
    "url": "https://github.com/YOUR_NAME/dsh-deep-line-theme/issues"
  }
}
